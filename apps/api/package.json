{
  "name": "@smart-canvas/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "build": "node ../../scripts/bundle.mjs src/main.ts src/db/migrate-cli.ts",
    "start:prod": "node dist/db/migrate-cli.js && node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@node-rs/argon2": "^2.2.2",
    "@smart-canvas/core": "workspace:*",
    "@smart-canvas/presets": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "fontkit": "^2.0.4",
    "image-size": "^2.0.4",
    "pg": "^8.23.1",
    "pg-boss": "12.35.1",
    "saxes": "^6.0.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/pg": "^8.23.1",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
