# Copy to .env and fill in. Never commit .env.
# Use URL-safe characters (letters, digits, - _ .) in passwords: they are placed in DATABASE_URL.

POSTGRES_USER=smartcanvas
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=smartcanvas

MINIO_ROOT_USER=smartcanvas
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8-chars
S3_BUCKET=smart-canvas

# true behind HTTPS (Dokploy). Set false only for plain http://localhost.
COOKIE_SECURE=true

# Host port for the web app (local).
WEB_PORT=8080

# Where `docker buildx bake --push` sends images, and which tag compose uses.
IMAGE_REGISTRY=ghcr.io/tolakang/smart-canvas
IMAGE_TAG=latest
